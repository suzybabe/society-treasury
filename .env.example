# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Privy (dashboard.privy.io → your app → Settings → Basics)
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: an app client ID if you set one up for this environment
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Server-side only. Keep secret.
PRIVY_APP_SECRET=

# Postgres connection string. On Railway this comes from the Postgres service:
# set DATABASE_URL=${{Postgres.DATABASE_URL}} on the app service.
# For local development use the Postgres service's public URL (DATABASE_PUBLIC_URL).
DATABASE_URL=

# Comma-separated. Each person listed becomes a (co-)president when they sign
# up, or on their next sign-in if they already have an account.
BOOTSTRAP_PRESIDENT_EMAIL=

# Optional defaults used when the society is first created.
SOCIETY_NAME=Computing Society
SOCIETY_SHORT_NAME=COMPSOC
SOCIETY_TERM=2026/27

# NEAR contract (testnet). The backend records passes, roles, settings,
# requests, votes and receipts on it, on behalf of each member.
NEAR_NETWORK=testnet
NEAR_CONTRACT_ID=society-treasury.testnet
NEXT_PUBLIC_NEAR_CONTRACT_ID=society-treasury.testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Function-call access key on the contract account (pays the gas, so members
# never do). Server-side only, keep it secret. Without it, records queue up
# and are sent once it is set.
NEAR_RECORDER_PRIVATE_KEY=
